{
  "name": "instagram-tool-care",
  "version": "1.0.25",
  "description": "JS Instagram - Social Media Management & Automation",
  "author": "Jason Nguyen <ndnvu2811@gmail.com>",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "setup:build": "node copy-build-files.js",
    "dist": "npm run setup:build && npm run build && electron-builder",
    "dist:win": "npm run setup:build && npm run build && electron-builder --win",
    "dist:mac": "npm run setup:build && npm run build && electron-builder --mac",
    "dist:linux": "npm run setup:build && npm run build && electron-builder --linux",
    "dist:portable": "npm run setup:build && npm run build && electron-builder --win --portable"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^2.7.0",
    "node-machine-id": "^1.1.12",
    "playwright-core": "^1.56.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.instagram.toolcare",
    "productName": "Instagram Tool Care",
    "asar": true,
    "asarUnpack": [
      "electron/**/*",
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "public/icon.ico",
      "public/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Instagram Tool Care",
      "include": "build/installer.nsh"
    }
  }
}
